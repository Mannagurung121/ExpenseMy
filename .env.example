# ExpenseMy — Environment Variable Template
# =========================================================================
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and MUST NEVER be committed.
# These variables are consumed locally by Fastlane lanes and, in CI, are
# provided as GitHub Actions Secrets (see docs/secrets-setup.md). The names
# here match the GitHub Secret names exactly so the two stay in sync.
#
# Setup instructions for obtaining each value: docs/secrets-setup.md
# =========================================================================

# Your Apple ID email — the account used for App Store Connect / TestFlight.
# Where: the email you sign in with at appstoreconnect.apple.com.
# Used by: fastlane `beta` and `release` lanes (beta.yml, release.yml).
APPLE_ID=your_apple_id@email.com

# App-specific password for non-interactive Apple sign-in (uploads/delivery).
# Where: appleid.apple.com → Sign-In and Security → App-Specific Passwords.
# Used by: fastlane `beta` and `release` lanes (TestFlight/App Store upload).
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Apple Developer Team ID.
# Where: developer.apple.com/account → Membership details → Team ID.
# Used by: fastlane `beta` and `release` lanes (signing + upload).
TEAM_ID=XXXXXXXXXX

# Passphrase that encrypts the Fastlane Match certificate repository.
# Where: chosen by you when running `fastlane match init` (store in a password
#        manager — encrypted certificates are unrecoverable without it).
# Used by: fastlane `match` in the `beta` and `release` lanes.
MATCH_PASSWORD=your_match_encryption_password

# HTTPS URL of the PRIVATE git repo that stores Match's encrypted certs/profiles.
# Where: create a private GitHub repo (e.g. your-org/certificates) and copy its
#        HTTPS clone URL. May embed a PAT for CI: https://<token>@github.com/...
# Used by: fastlane `match` in the `beta` and `release` lanes.
MATCH_GIT_URL=https://github.com/your-org/certificates.git

# Same value as APP_SPECIFIC_PASSWORD. Fastlane's pilot/deliver read this
# specific variable name when authenticating with App Store Connect.
# Where: same app-specific password generated at appleid.apple.com.
# Used by: fastlane `beta` lane (pilot/TestFlight upload).
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=same_as_above

# GitHub Personal Access Token used by Danger to post PR review comments.
# Where: github.com/settings/tokens → classic token with `repo` (or
#        `public_repo` for public repos) scope.
# Used by: danger.yml workflow.
DANGER_GITHUB_API_TOKEN=ghp_xxxxxxxxxxxx

# Authentication token for SonarCloud static analysis.
# Where: sonarcloud.io → My Account → Security → Generate Tokens.
# Used by: sonar.yml workflow (see docs/sonarcloud-setup.md).
SONAR_TOKEN=sqp_xxxxxxxxxxxx
